   "versionNonce": 1612792136,
   "text": "CE QU'IL NE FAIT JAMAIS",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CE QU'IL NE FAIT JAMAIS",
   "autoResize": true,
