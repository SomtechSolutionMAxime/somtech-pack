   "id": "lFsTw4tGVLtEPJ9VpLLh0",
   "type": "text",
   "x": 1592,
   "y": 275,
   "width": 236.8,
   "height": 245.0,
   "strokeColor": "#c92a2a",
   "backgroundColor": "transparent",
   "index": "a036",
   "seed": 1868998417,
   "versionNonce": 1253575432,
   "text": "Il n'amende aucun ABC.\nIl ne rend aucun métier.\nIl ne fait converger personne.\nIl n'ouvre aucun ticket.\n\nUne seule session qui suivrait\nces instructions ne pourrait pas\ntenir la contradiction :\nelle ne se contredit pas\nelle-même.\n\nC'est pourquoi c'est un\nWORKFLOW et pas une\ncompétence.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Il n'amende aucun ABC.\nIl ne rend aucun métier.\nIl ne fait converger personne.\nIl n'ouvre aucun ticket.\n\nUne seule session qui suivrait\nces instructions ne pourrait pas\ntenir la contradiction :\nelle ne se contredit pas\nelle-même.\n\nC'est pourquoi c'est un\nWORKFLOW et pas une\ncompétence.",
   "autoResize": true,
   "lineHeight": 1.25
  },
